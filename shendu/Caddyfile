{$SHENDU_DOMAIN} {
  encode zstd gzip

  @site_backup path /api/admin/site-backup/*
  handle @site_backup {
    request_body {
      max_size 180MB
    }
    reverse_proxy shendu:3000
  }

  @personal_backup path /api/data/*
  handle @personal_backup {
    request_body {
      max_size 50MB
    }
    reverse_proxy shendu:3000
  }

  handle {
    request_body {
      max_size 2MB
    }
    reverse_proxy shendu:3000
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    -Server
  }
  log {
    output stdout
    format filter {
      wrap console
      fields {
        request>uri regexp \?.* ""
      }
    }
  }
}
